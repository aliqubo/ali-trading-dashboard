# Ali Trading Dashboard — environment template.
# Copy to .env and adjust. NEVER commit a real .env (ARCHITECTURE.md §10).

# --- Application ---
APP_NAME=Ali Trading Dashboard
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ali
POSTGRES_PASSWORD=ali_password
POSTGRES_DB=ali_trading
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
